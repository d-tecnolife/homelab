# Encrypt a copy as gateway.sops.env. It is the single encrypted credential
# input for Gateway bootstrap and post-install Tailscale enrollment. Do not
# commit plaintext values or print the decrypted file.
#
# The bootstrap renderer derives a bcrypt hash locally; the generated config
# contains only that hash and the supplied public SSH key.
GATEWAY_ROOT_PASSWORD=replace-with-a-memorable-unique-console-password
OPNSENSE_URL=https://172.16.10.1
# Generated by scripts/gateway/create-gateway-secret.sh. These are seeded into
# the initial Gateway config so no web-GUI/API-key creation is required.
OPNSENSE_API_KEY=replace-me
OPNSENSE_API_SECRET=replace-me
TAILSCALE_OAUTH_CLIENT_ID=replace-me
TAILSCALE_OAUTH_CLIENT_SECRET=replace-me
