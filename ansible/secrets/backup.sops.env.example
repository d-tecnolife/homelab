# Encrypt a copy as backup.sops.env. app-data-backups.yml configures the
# nightly offsite backup on Apps only once that file exists. Do not commit
# plaintext values or print the decrypted file.
#
# Cloudflare R2: create a bucket, then an R2 API token with Object Read & Write
# limited to that bucket. The bucket's settings page shows the S3 endpoint.
RESTIC_REPOSITORY=s3:https://replace-with-account-id.r2.cloudflarestorage.com/homelab-backups
AWS_ACCESS_KEY_ID=replace-with-r2-access-key-id
AWS_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
# Generate once, for example with `openssl rand -base64 48`, and keep a copy
# beside the age identity: the repository is unreadable without it.
RESTIC_PASSWORD=replace-with-a-long-random-password
# Optional until Vault is initialized: a periodic token limited to the
# homelab-raft-snapshot policy. See secrets/README.md.
VAULT_SNAPSHOT_TOKEN=
