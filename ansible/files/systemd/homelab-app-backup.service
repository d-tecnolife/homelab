[Unit]
Description=Back up Apps data to the offsite restic repository
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# A oneshot has no start timeout by default. restic once stalled indefinitely
# reading from R2, so a stuck run is killed and reported as a failed backup.
TimeoutStartSec=1h
ExecStart=/usr/local/sbin/homelab-app-backup
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
