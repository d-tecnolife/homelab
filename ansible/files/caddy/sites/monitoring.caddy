monitor.dscim.dev {
	tls {
		dns cloudflare {env.CF_API_TOKEN}
		resolvers 1.1.1.1
	}

	# 172.16.0.0/12 is required: Ops is the Tailscale subnet router and source-NATs
	# tailnet traffic, so Caddy sees Ops' DMZ address rather than a 100.64 client.
	# Without it every Tailscale user is refused; auth and jobs already include it.
	@outside_private_networks not remote_ip 100.64.0.0/10 192.168.1.0/24 172.16.0.0/12
	respond @outside_private_networks "Private network access required" 403

	reverse_proxy 172.16.10.20:3000

	log {
		output file /var/log/caddy/monitoring-access.json {
			roll_size 25MiB
			roll_keep 5
			roll_keep_for 168h
		}
		format json
	}
}
