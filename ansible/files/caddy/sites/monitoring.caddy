monitor.dscim.dev {
	tls {
		dns cloudflare {env.CF_API_TOKEN}
		resolvers 1.1.1.1
	}

	@outside_netbird not remote_ip 100.64.0.0/10
	respond @outside_netbird "VPN access required" 403

	reverse_proxy 10.100.1.30:3000

	log {
		output file /var/log/caddy/monitoring-access.json {
			roll_size 25MiB
			roll_keep 5
			roll_keep_for 168h
		}
		format json
	}
}
