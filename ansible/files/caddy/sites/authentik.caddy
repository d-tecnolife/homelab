auth.dscim.dev {
	tls {
		dns cloudflare {env.CF_API_TOKEN}
		resolvers 1.1.1.1
	}

	@outside_private_networks not remote_ip 100.64.0.0/10 192.168.1.0/24 10.100.1.0/24 10.200.1.0/24
	respond @outside_private_networks "Private network access required" 403

	reverse_proxy 10.200.1.10:9000

	log {
		output file /var/log/caddy/authentik-access.json {
			roll_size 25MiB
			roll_keep 5
			roll_keep_for 168h
		}
		format json
	}
}
