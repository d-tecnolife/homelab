ssh-ca.dscim.dev {
	tls {
		dns cloudflare {env.CF_API_TOKEN}
		resolvers 1.1.1.1
	}

	# NetBird clients retain a 100.64.0.0/10 source address at Edge.
	@vpn remote_ip 100.64.0.0/10
	handle @vpn {
		reverse_proxy 10.200.1.10:8200
	}
	respond "VPN access required" 403

	log {
		output file /var/log/caddy/vault-ssh-ca-access.json {
			roll_size 25MiB
			roll_keep 5
			roll_keep_for 168h
		}
		format json
	}
}
