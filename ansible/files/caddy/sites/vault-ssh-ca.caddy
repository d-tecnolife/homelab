ssh-ca.dscim.dev {
	tls {
		dns cloudflare {env.CF_API_TOKEN}
		resolvers 1.1.1.1
	}

	# NetBird clients retain a 100.64.0.0/10 source address at Edge.
	@trusted remote_ip 100.64.0.0/10 192.168.1.0/24
	handle @trusted {
		reverse_proxy 10.200.1.10:8200
	}
	respond "VPN or home-network access required" 403
}
