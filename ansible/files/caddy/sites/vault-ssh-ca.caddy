ssh-ca.dscim.dev {
	tls {
		dns cloudflare {env.CF_API_TOKEN}
		resolvers 1.1.1.1
	}

	# Vault authenticates every API request. Keep the backend private to Apps.
	reverse_proxy 10.200.1.10:8200

	log {
		output file /var/log/caddy/vault-ssh-ca-access.json {
			roll_size 25MiB
			roll_keep 5
			roll_keep_for 168h
		}
		format json
	}
}
