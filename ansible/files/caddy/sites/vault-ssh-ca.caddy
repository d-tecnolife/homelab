ssh-ca.dscim.dev {
	tls {
		dns cloudflare {env.CF_API_TOKEN}
		resolvers 1.1.1.1
	}

	# Permit NetBird plus the private ranges used by this homelab.
	@trusted remote_ip 100.64.0.0/10 10.0.0.0/8 192.168.0.0/16
	handle @trusted {
		reverse_proxy 10.200.1.10:8200
	}
	respond "Private-network access required" 403
}
