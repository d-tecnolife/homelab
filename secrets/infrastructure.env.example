TF_VAR_proxmox_endpoint=https://192.0.2.10:8006/
TF_VAR_proxmox_api_token=terraform@pve!provider=replace-me
# Tailscale OAuth client with policy-file scope. The Tailscale root uses this
# only when invoked through scripts/terraform-with-secrets.sh tailscale <action>.
TAILSCALE_OAUTH_CLIENT_ID=replace-me
TAILSCALE_OAUTH_CLIENT_SECRET=replace-me
TAILSCALE_TAILNET=-
# The same seeded homelab-automation Gateway API credential used by
# ansible/secrets/gateway.sops.env. The opnsense root uses this only when
# invoked through scripts/terraform-with-secrets.sh opnsense <action>.
OPNSENSE_API_KEY=replace-me
OPNSENSE_API_SECRET=replace-me
