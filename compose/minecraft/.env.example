# First-boot step (not automated -- run once after the container is up):
#   docker exec minecraft rcon-cli gamerule spawn_phantoms false
# This is a vanilla gamerule, not a mod (renamed from doInsomnia before
# 26.2 shipped); it persists in the world save, so it only needs to run
# once, not on every restart. Already applied live on 2026-09-21.
#
# Whitelist is managed in-game (/whitelist add|remove) or via RCON, not an
# env var here -- see docker-compose.yml for why.
RCON_PASSWORD=replace-with-a-long-random-secret
