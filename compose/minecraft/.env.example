# First-boot step (not automated -- run once after the container is up):
#   docker exec minecraft rcon-cli gamerule doInsomnia false
# This is a vanilla gamerule, not a mod; it persists in the world save, so
# it only needs to run once, not on every restart.
RCON_PASSWORD=replace-with-a-long-random-secret
WHITELIST=player_one,player_two
