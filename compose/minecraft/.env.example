# Gamerules (spawn_phantoms, players_sleeping_percentage) are applied on
# every start through RCON_CMDS_STARTUP in docker-compose.yml, not by hand:
# they live in the world save, so a one-off /gamerule is lost whenever the
# world is recreated.
#
# Whitelist is managed in-game (/whitelist add|remove) or via RCON, not an
# env var here -- see docker-compose.yml for why.
RCON_PASSWORD=replace-with-a-long-random-secret
